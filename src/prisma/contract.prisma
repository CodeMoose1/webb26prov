// use prisma-8

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  tokenHash    String    @unique @default("")
  votes        Vote[]
}

model Motion {
  id          String     @id @default(uuid())
  text        String
  votes       Vote[]
}

model Vote {
  id          Int        @id @default(autoincrement())
  value       Boolean    
  motion_id   String     
  motion      Motion     @relation(fields: [motion_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
